# ==============================================================================
# BootcampGIS GeoAI Stack — Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the active '.env' file to version control.
# ==============================================================================

# --- GOOGLE CLOUD & AI ---
PROJECT_ID=your_gcp_project_id
GCP_API_KEY=your_gcp_api_key_for_routes
GOOGLE_API_KEY=your_google_gemini_api_key
LLM_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# --- LANGSMITH TRACING ---
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=GeoAI_Bootcamp

# --- DATABASE & GEOSERVER ---
DATABASE_URL=postgresql://postgres:12345@localhost:5432/bootcampgis
DB_USER=postgres
DB_NAME=bootcampgis
DB_PASSWORD=your_db_password
GEOSERVER_ADMIN_PASS=your_geoserver_admin_password

# --- KAGGLE & DEPLOYMENT ---
KAGGLE_TUNNEL_URL=  # leave empty for local development
KAGGLE_API_TOKEN=your_kaggle_api_token

# --- EXTERNAL APIs (CENSUS & GEO) ---
CENSUS_API_KEY=your_census_api_key
CENSUS_YEAR=2023
TARGET_STATE=12      # Florida FIPS
TARGET_COUNTY=057    # Hillsborough County FIPS
TARGET_PLACE=71000   # Tampa City FIPS
